# The collector never calls upstream APIs unless a real source adapter is enabled.
COLLECTOR_SOURCE=demo
COLLECTOR_DRY_RUN=1
# Set to 1 for production runs so a partial batch fails the job.
COLLECTOR_FAIL_ON_ERROR=1
# Set both values to write through the protected API ingestion endpoint.
INGEST_API_URL=http://localhost:8787
INGEST_KEY=replace-with-a-local-ingest-key
# Pocket48 is only required when COLLECTOR_SOURCE=pocket48.
# POCKET48_TOKEN=
# POCKET48_DEVICE_ID=
