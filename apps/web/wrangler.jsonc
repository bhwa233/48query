{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starter-web",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "http://localhost:3000",
    "NEXT_PUBLIC_API_BASE_URL": ""
  }
}
