{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "48query-web",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "48.bhwa233.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "QUERY_API",
      "service": "48query-api"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://48.bhwa233.com",
    "NEXT_PUBLIC_API_BASE_URL": "/"
  }
}
