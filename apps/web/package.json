{
  "name": "@starter/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev --port 3000",
    "build": "vinext build && node ../../scripts/normalize-web-build.mjs",
    "start": "vinext start --port 3000",
    "preview": "wrangler dev --config dist/server/wrangler.json --port 3000",
    "lint": "oxlint -c .oxlintrc.json . --type-aware",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.ts",
    "rsc:check": "node ../../scripts/check-rsc-boundaries.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm i18n:check && pnpm rsc:check && pnpm build",
    "deploy": "wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "lucide-react": "1.58.0",
    "class-variance-authority": "0.7.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@starter/shared": "workspace:*",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "vinext": "1.2.1",
    "vite": "8.3.4",
    "@cloudflare/vite-plugin": "1.64.0",
    "@vitejs/plugin-rsc": "0.5.38",
    "@vitejs/plugin-react": "6.1.2",
    "next": "16.4.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.30",
    "wrangler": "4.151.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@starter/config-ts": "workspace:*",
    "@mdx-js/rollup": "3.1.1"
  }
}
