{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "48query-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "CORS_ORIGINS": "https://48.bhwa233.com,https://48query-web.404174262.workers.dev"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "48query-db",
      "database_id": "715563ed-4624-450d-99d3-a4e0242c90ab",
      "migrations_dir": "migrations"
    }
  ]
}
