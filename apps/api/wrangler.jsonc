{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starter-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "CORS_ORIGINS": "http://localhost:3000"
  },
  "observability": {
    "enabled": true
  }
}
